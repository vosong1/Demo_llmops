# Sao chép thành .env rồi điền giá trị. File .env KHÔNG được commit.

# Khóa admin của LiteLLM gateway. Bỏ trống thì lần chạy đầu tự sinh và ghi vào .env.
LITELLM_MASTER_KEY=

# Khóa nhà cung cấp cloud (chỉ cần khi bật model tương ứng trong litellm_config.yaml)
GEMINI_API_KEY=
# CUSTOMLLM_API_KEY=

# Tùy chọn: đổi cổng / host
# DASHBOARD_PORT=8765
# OLLAMA_PORT=11434
# LITELLM_PORT=4000
# PHOENIX_PORT=6006
# LITELLM_BIND_HOST=127.0.0.1
