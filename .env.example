# Sao chép thành .env rồi điền giá trị (hoặc chạy: python scripts/init_env.py). File .env KHÔNG được commit.
# Lưu ý: không viết chú thích cuối dòng (KEY=value # ghi chú), vì phần ghi chú sẽ bị tính vào giá trị.

# ===== Bí mật =====
# Khóa admin của LiteLLM gateway. Chạy local: bỏ trống thì lần chạy đầu tự sinh và ghi vào .env.
# Docker: bắt buộc có giá trị, hãy chạy python scripts/init_env.py để sinh.
LITELLM_MASTER_KEY=

# Khóa nhà cung cấp cloud (chỉ cần khi dùng model tương ứng trong litellm_config.yaml)
GEMINI_API_KEY=
# CUSTOMLLM_API_KEY=

# ===== Cổng (chạy local) =====
# DASHBOARD_PORT=8765
# OLLAMA_PORT=11434
# LITELLM_PORT=4000
# PHOENIX_PORT=6006
# Nếu Phoenix báo "Failed to bind to address [::]:4317" thì cổng gRPC đang bị chiếm, đổi bằng:
# PHOENIX_GRPC_PORT=4318
# LITELLM_BIND_HOST=127.0.0.1

# ===== Triển khai (Docker, VPS, reverse proxy) =====
# Địa chỉ các dịch vụ mà dashboard gọi tới. Docker Compose đã tự đặt sẵn, chỉ cần khi chạy dịch vụ ở máy khác.
# OLLAMA_URL=http://localhost:11434
# LITELLM_URL=http://localhost:4000
# PHOENIX_URL=http://localhost:6006

# Địa chỉ dashboard lắng nghe. Mặc định 127.0.0.1 (chỉ máy này). Docker đặt 0.0.0.0 trong image.
# DASHBOARD_HOST=127.0.0.1
# Thư mục lưu users.json, chats/, logs/, docs/, models.json, limits.json (mặc định: thư mục dự án)
# DATA_DIR=

# Khi truy cập qua tên miền + HTTPS:
#   ALLOWED_HOSTS  tên miền được phép (cách nhau bằng dấu phẩy), chống DNS rebinding
#   COOKIE_SECURE  1 = chỉ gửi cookie phiên qua HTTPS
#   TRUST_PROXY    1 = lấy IP người dùng từ X-Forwarded-For của reverse proxy (chỉ bật khi thực sự có proxy đứng trước)
# DOMAIN=llm.example.com
# ALLOWED_HOSTS=llm.example.com
# COOKIE_SECURE=1
# TRUST_PROXY=1

# 0 = dashboard không bật/tắt Ollama/LiteLLM/Phoenix (do Docker hoặc systemd quản lý). Docker đã đặt sẵn 0.
# MANAGE_SERVICES=1
# 1 = không tự mở trình duyệt khi khởi động
# NO_BROWSER=0

# Docker: model tải về khi chạy "docker compose run --rm ollama-pull" (cách nhau bằng dấu cách)
# PULL_MODELS=qwen2.5:3b qwen2.5:7b
